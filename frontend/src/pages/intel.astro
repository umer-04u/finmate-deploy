---
import Layout from '../layouts/Layout.astro';
import { Brain, Sparkles, Activity, Search, ShieldAlert, LineChart } from 'lucide-react';
---

<Layout title="Neural Intelligence Architecture">
	<main class="intel-page">
		<nav class="premium-nav">
			<div class="nav-container">
				<a href="/" class="nav-logo">
					<div class="logo-wrapper" style="width: 32px; height: 32px;">
            <img src="/logo.svg" alt="Logo" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
				</a>
				<div class="nav-links-wrapper">
					<div class="nav-links">
						<a href="/platform" class="nav-link">Platform</a>
						<a href="/intelligence" class="nav-link">Intelligence</a>
						<a href="/sovereignty" class="nav-link">Sovereignty</a>
					</div>
					<a href="/#auth" class="btn-premium" style="padding: 10px 20px; font-size: 0.75rem;">
						INITIALIZE
					</a>
				</div>
			</div>
		</nav>

		<section class="intel-hero animate-reveal">
			<div class="mesh-bg"></div>
			<div class="hero-content">
				<div class="intel-badge">
					<Sparkles size={14} />
					<span>NEURAL CORE ACTIVE</span>
				</div>
				<h1 class="text-gradient">Neural <span class="serif">Architecture</span></h1>
				<p class="subtitle">The high-fidelity intelligence layer powering the FinMate ecosystem.</p>
			</div>
		</section>

		<section class="intel-grid-section">
			<div class="bento-grid" style="max-width: 1400px; margin: 0 auto; padding: 4rem 2rem;">
				<!-- Autonomous Classification -->
				<div class="glass-card intel-card animate-reveal delay-1 grid-full-width">
					<div class="card-inner">
						<div class="icon-box primary">
							<Search size={32} />
						</div>
						<div class="text-content">
							<span class="category-label">ENGINE 01</span>
							<h3>Autonomous Classification</h3>
							<p>Our proprietary categorization engine leverages advanced Random Forest and Gradient Boosting algorithms to identify and classify transactions with near-perfect accuracy. It learns from thousands of historical patterns to ensure your ledger is always organized.</p>
						</div>
					</div>
				</div>

				<!-- Anomaly Detection -->
				<div class="glass-card intel-card animate-reveal delay-2 grid-span-2">
					<div class="card-inner">
						<div class="icon-box rose">
							<ShieldAlert size={32} />
						</div>
						<div class="text-content">
							<span class="category-label">ENGINE 02</span>
							<h3>Anomaly Sentinel</h3>
							<p>Pattern recognition that goes beyond simple thresholding. The Sentinel detects statistical outliers and irregular spending nodes, providing early warning signals for potentially unauthorized activity or unintended expenditure spikes.</p>
						</div>
					</div>
				</div>

				<!-- Predictive Forecasting -->
				<div class="glass-card intel-card animate-reveal delay-2">
					<div class="card-inner">
						<div class="icon-box emerald">
							<LineChart size={32} />
						</div>
						<div class="text-content">
							<span class="category-label">ENGINE 03</span>
							<h3>Predictive Forecasting</h3>
							<p>Utilizing time-series analysis and exponential smoothing models, FinMate projects your future wealth trajectory based on historical velocity.</p>
						</div>
					</div>
				</div>

				<!-- LLM Integration -->
				<div class="glass-card intel-card animate-reveal delay-3 grid-span-2">
					<div class="card-inner">
						<div class="icon-box secondary">
							<Brain size={32} />
						</div>
						<div class="text-content">
							<span class="category-label">INTEFACE 01</span>
							<h3>FinMate AI (LLM Integration)</h3>
							<p>Powered by the lightning-fast Groq LPU™ Inference Engine, our financial assistant provides a conversational layer over your data. It synthesizes complex transactions into actionable advice, all while maintaining strict data sovereignty through zero-knowledge context injection.</p>
						</div>
					</div>
				</div>

				<!-- Privacy Protocol -->
				<div class="glass-card intel-card animate-reveal delay-3">
					<div class="card-inner">
						<div class="icon-box mono">
							<Activity size={32} />
						</div>
						<div class="text-content">
							<span class="category-label">PROTOCOL</span>
							<h3>Edge Processing</h3>
							<p>Intelligence without exposure. Our AI models are optimized to process context locally, ensuring your raw data never leaves the vault.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<footer class="premium-footer">
			<div class="footer-container">
				<div class="footer-bottom">
					<p>© 2026 FINMATE NEURAL DIVISION. ALL RIGHTS RESERVED.</p>
					<a href="/" class="back-link">SYSTEM_CORE.EXE</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>

<style>
	.intel-page {
		min-height: 100vh;
		background: var(--mono-0);
		color: var(--mono-90);
	}

	.premium-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		padding: 2rem 4rem;
		backdrop-filter: blur(15px);
		border-bottom: 1px solid var(--border-subtle);
	}

	.nav-container {
		max-width: 1400px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav-links-wrapper { display: flex; align-items: center; gap: 4rem; }
	.nav-links { display: flex; gap: 2.5rem; }
	.nav-link { font-size: 0.8rem; font-weight: 700; color: var(--mono-40); text-transform: uppercase; letter-spacing: 0.15em; transition: var(--transition-smooth); }
	.nav-link:hover { color: var(--mono-100); transform: translateY(-2px); }

	.intel-hero {
		padding: 15rem 2rem 8rem;
		text-align: center;
		position: relative;
	}

	.intel-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px;
		background: rgba(99, 102, 241, 0.1);
		border: 1px solid rgba(99, 102, 241, 0.2);
		border-radius: 100px;
		color: var(--accent-primary);
		font-size: 0.65rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		margin-bottom: 2rem;
	}

	.intel-hero h1 {
		font-size: clamp(3.5rem, 8vw, 6rem);
		margin-bottom: 1.5rem;
		line-height: 1.1;
	}

	.subtitle {
		color: var(--mono-40);
		font-size: 1.25rem;
		max-width: 700px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.intel-grid-section {
		background: radial-gradient(circle at bottom, rgba(99, 102, 241, 0.05) 0%, transparent 50%);
	}

	.intel-card {
		padding: 4rem;
		transition: var(--transition-smooth);
	}

	.card-inner {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.icon-box {
		width: 64px;
		height: 64px;
		border-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-subtle);
		color: var(--mono-100);
	}

	.icon-box.primary { color: var(--accent-primary); border-color: rgba(99, 102, 241, 0.3); background: rgba(99, 102, 241, 0.05); }
	.icon-box.rose { color: var(--accent-rose); border-color: rgba(244, 63, 94, 0.3); background: rgba(244, 63, 94, 0.05); }
	.icon-box.emerald { color: var(--accent-emerald); border-color: rgba(16, 185, 129, 0.3); background: rgba(16, 185, 129, 0.05); }
	.icon-box.secondary { color: var(--accent-secondary); border-color: rgba(14, 165, 233, 0.3); background: rgba(14, 165, 233, 0.05); }

	.category-label {
		display: block;
		font-size: 0.6rem;
		font-weight: 900;
		color: var(--mono-40);
		letter-spacing: 0.2em;
		margin-bottom: 0.5rem;
	}

	.intel-card h3 { font-size: 2rem; margin-bottom: 1rem; }
	.intel-card p { color: var(--mono-40); line-height: 1.7; font-size: 1rem; }

	.grid-full-width { grid-column: 1 / -1; }
	.grid-span-2 { grid-column: span 2; }

	.premium-footer {
		padding: 6rem 4rem;
		border-top: 1px solid var(--border-subtle);
		background: rgba(2, 6, 23, 0.5);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: var(--mono-40);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.05em;
	}

	.back-link {
		color: var(--accent-primary);
		text-decoration: none;
		padding: 8px 16px;
		border: 1px solid rgba(99, 102, 241, 0.2);
		border-radius: 8px;
		transition: var(--transition-smooth);
	}

	.back-link:hover {
		background: rgba(99, 102, 241, 0.1);
		transform: scale(1.05);
	}

	@media (max-width: 1024px) {
		.premium-nav { padding: 1.5rem 2rem; }
		.nav-links { display: none; }
		.intel-hero { padding: 10rem 1.5rem 4rem; }
		.intel-card { padding: 2.5rem; }
		.grid-span-2 { grid-column: span 1; }
		.footer-bottom { flex-direction: column; gap: 2rem; text-align: center; }
	}
</style>
