---
import Layout from '../layouts/Layout.astro';
import ChatBot from '../components/ChatBot';
import { ArrowLeft } from 'lucide-react';
---

<Layout title="Intelligence">
	<main class="intelligence-page">
		<div class="mesh-bg"></div>
		<div class="intelligence-content animate-reveal">
			<header class="intel-header">
				<div class="intel-nav-top">
					<a href="/dashboard" class="btn-back">
						<ArrowLeft size={16} /> <span class="btn-text">RETURN TO COMMAND CENTER</span>
					</a>
				</div>
				<h1 class="header-title">Neural <span class="serif">Intelligence</span></h1>
				<p class="header-subtitle">Direct link to your financial consciousness.</p>
			</header>
			
			<div class="chat-container-fs">
				<ChatBot client:only="react" fullScreen={true} />
			</div>
		</div>
	</main>
</Layout>

<style>
	.intelligence-page {
		min-height: 100vh;
		background: var(--mono-0);
		display: flex;
		flex-direction: column;
		padding: 4rem 5rem;
		position: relative;
		overflow: hidden;
	}

	.intel-nav-top {
		margin-bottom: 2rem;
	}

	.btn-back {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--mono-40);
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 0.15em;
		transition: var(--transition-smooth);
	}

	.btn-back:hover {
		color: var(--accent-primary);
		transform: translateX(-5px);
	}

	.intelligence-content {
		max-width: 1400px;
		margin: 0 auto;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		flex: 1;
		z-index: 10;
	}

	.intel-header {
		margin-bottom: 4rem;
	}

	.header-title {
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.header-subtitle {
		color: var(--mono-40);
		font-size: 1.1rem;
	}

	.chat-container-fs {
		flex: 1;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 2rem;
	}

	@media (max-width: 1024px) {
		.intelligence-page {
			padding: 2rem;
		}
		.header-title {
			font-size: 2.25rem;
		}
	}

	@media (max-width: 640px) {
		.intelligence-page {
			padding: 1.5rem;
		}
		.intel-header {
			margin-bottom: 2rem;
		}
		.header-title {
			font-size: 1.75rem;
		}
		.chat-container-fs {
			margin-bottom: 0;
		}
	}
</style>
