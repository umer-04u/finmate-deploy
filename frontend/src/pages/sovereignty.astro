---
import Layout from '../layouts/Layout.astro';
import { Lock, EyeOff, ShieldCheck, Key } from 'lucide-react';
---

<Layout title="Data Sovereignty">
	<main class="sovereignty-page">
		<nav class="premium-nav">
			<div class="nav-container">
				<a href="/" class="nav-logo">
					<div class="logo-wrapper" style="width: 32px; height: 32px;">
            <img src="/logo.svg" alt="Logo" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
				</a>
				<div class="nav-links-wrapper">
					<div class="nav-links">
						<a href="/platform" class="nav-link">Platform</a>
						<a href="/intelligence" class="nav-link">Intelligence</a>
						<a href="/sovereignty" class="nav-link">Sovereignty</a>
					</div>
					<a href="/#auth" class="btn-premium" style="padding: 10px 20px; font-size: 0.75rem;">
						INITIALIZE
					</a>
				</div>
			</div>
		</nav>

		<section class="hero-sub animate-reveal">
			<div class="mesh-bg"></div>
			<h1 class="text-gradient">Absolute Sovereignty</h1>
			<p class="subtitle">Your financial data, locked in a monolith only you can access.</p>
		</section>

		<section class="sovereignty-content animate-reveal delay-2">
			<div class="bento-grid" style="max-width: 1200px; margin: 0 auto; padding: 4rem 2rem 12rem;">
				<div class="glass-card item-card" style="grid-column: span 2;">
					<Lock size={40} className="text-rose-500" />
					<h3>End-to-End Encryption</h3>
					<p>AES-256 GCM encryption ensures that your data is scrambled before it ever touches our infrastructure.</p>
				</div>
				<div class="glass-card item-card" style="grid-column: span 2;">
					<EyeOff size={40} className="text-sky-500" />
					<h3>Zero-Knowledge Architecture</h3>
					<p>We provide the engine, but you hold the keys. We cannot access your data, even if we were compelled to.</p>
				</div>
				<div class="glass-card item-card">
					<ShieldCheck size={40} className="text-emerald-500" />
					<h4>Local Compute</h4>
					<p>Processing happens in your secure browser sandbox.</p>
				</div>
				<div class="glass-card item-card" style="grid-column: span 3;">
					<Key size={40} className="text-amber-500" />
					<h4>Decentralized Identity</h4>
					<p>Own your financial profile across multiple platforms with our sovereign identity protocol.</p>
				</div>
			</div>
		</section>

		<footer class="premium-footer">
			<div class="footer-container">
				<div class="footer-bottom">
					<p>© 2026 FINMATE PROTOCOL. ALL RIGHTS RESERVED.</p>
					<a href="/" style="color: var(--accent-primary); font-weight: 700;">RETURN TO CORE</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>

<style>
	.sovereignty-page { min-height: 100vh; background: var(--mono-0); }
	.hero-sub { padding: 12rem 2rem 6rem; text-align: center; position: relative; }
	.hero-sub h1 { font-size: 5rem; margin-bottom: 1rem; }
	.subtitle { color: var(--mono-40); font-size: 1.5rem; max-width: 800px; margin: 0 auto; }
	
	.item-card { padding: 4rem; display: flex; flex-direction: column; gap: 1.5rem; }
	.item-card h3 { font-size: 1.75rem; color: var(--mono-100); }
	.item-card p { color: var(--mono-40); line-height: 1.6; }

	.premium-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 2rem 4rem; backdrop-filter: blur(10px); border-bottom: 1px solid var(--border-subtle); }
	.nav-container { max-width: 1400px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
	.nav-links-wrapper { display: flex; align-items: center; gap: 4rem; }
	.nav-links { display: flex; gap: 2.5rem; }
	.nav-link { font-size: 0.8rem; font-weight: 700; color: var(--mono-40); text-transform: uppercase; letter-spacing: 0.1em; transition: var(--transition-smooth); }
	.nav-link:hover { color: var(--mono-100); transform: translateY(-2px); }

	.premium-footer { padding: 4rem; border-top: 1px solid var(--border-subtle); }
	.footer-bottom { display: flex; justify-content: space-between; color: var(--mono-40); font-size: 0.8rem; }

	@media (max-width: 768px) { .hero-sub h1 { font-size: 3rem; } }
</style>
