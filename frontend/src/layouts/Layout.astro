---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="FINMATE - AI-Powered Financial Intelligence Dashboard" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@400..800&display=swap" rel="stylesheet">
    <title>{title} | FINMATE</title>
    <ClientRouter />
  </head>
  <body class="antialiased selection:bg-cyan selection:text-black">
    <nav class="fixed top-0 w-full z-50 border-b border-white/10 bg-black/50 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-display font-bold text-2xl tracking-tighter hover:text-cyan transition-colors">
          FIN<span class="text-cyan">MATE</span>
        </a>
        <div class="flex items-center gap-6 text-sm font-mono font-bold tracking-widest uppercase">
          <a href="/dashboard" class="text-white/70 hover:text-white transition-colors">Dashboard</a>
          <a href="/login" class="brutal-btn py-1.5 px-4 text-xs">Launch Terminal</a>
        </div>
      </div>
    </nav>
    <main class="pt-16 min-h-screen">
      <slot />
    </main>
  </body>
</html>
