---
import { ArrowRight, ChevronDown, Sparkles } from 'lucide-react';
---

<section class="monolith-hero">
  <div class="mesh-bg"></div>
  
  <div class="hero-container">
    <div class="content-wrapper">
      <div class="top-meta animate-reveal">
        <div class="logo-wrapper">
          <img src="/logo.svg" alt="Logo" class="logo-svg" />
        </div>
        <div class="status-indicator">
          <span class="status-dot"></span>
          <span class="status-text">SYSTEM OPERATIONAL</span>
        </div>
        <span class="version">V1.2.0 // NEURAL_ENGINE</span>
      </div>
      
      <h1 class="hero-title animate-reveal delay-1">
        Master Your <br />
        <span class="text-gradient">Financial</span> <br />
        Narrative.
      </h1>
      
      <div class="meta-grid animate-reveal delay-2">
        <div class="meta-item">
          <span class="label">INTELLIGENCE</span>
          <span class="val">AUTONOMOUS CLASSIFICATION</span>
        </div>
        <div class="meta-item">
          <span class="label">PRIVACY</span>
          <span class="val">ZERO-KNOWLEDGE PROTOCOL</span>
        </div>
        <div class="meta-item">
          <span class="label">VELOCITY</span>
          <span class="val">REAL-TIME SYNC</span>
        </div>
      </div>

      <p class="hero-desc animate-reveal delay-3">
        Finmate is the high-fidelity command center for modern capital. 
        Engineered for precision, designed for clarity, and built for those 
        who demand absolute sovereignty over their data.
      </p>

      <div class="cta-wrapper animate-reveal delay-3" style="margin-top: 3rem;">
        <a href="#auth" class="btn-premium">
          INITIALIZE VAULT <Sparkles size={18} />
        </a>
        <a href="/about" class="btn-outline">
          VIEW MANIFESTO
        </a>
      </div>
    </div>
  </div>

  <div class="scroll-indicator">
    <ChevronDown size={24} />
  </div>

  <div class="decorative-blob"></div>
</section>

<style>
  .monolith-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding: 0 6rem;
    overflow: hidden;
  }

  .hero-container {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    z-index: 10;
  }

  .content-wrapper {
    max-width: 1000px;
  }

  .top-meta {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 3rem;
  }

  .logo-wrapper {
    width: 40px;
    height: 40px;
    filter: drop-shadow(0 0 10px var(--accent-glow));
  }

  .logo-svg {
    width: 100%;
    height: 100%;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-emerald);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--accent-emerald);
    animation: pulse 2s infinite;
  }

  .status-text {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--mono-60);
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  .version {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    color: var(--mono-40);
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, 7.5rem);
    line-height: 0.9;
    margin-bottom: 3.5rem;
    letter-spacing: -0.05em;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 2.5rem 0;
    margin-bottom: 3.5rem;
    position: relative;
  }

  .meta-grid::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 100px;
    height: 1px;
    background: var(--accent-primary);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .label {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--mono-40);
    letter-spacing: 0.15em;
  }

  .val {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--mono-80);
  }

  .hero-desc {
    font-size: 1.35rem;
    color: var(--mono-40);
    max-width: 650px;
    line-height: 1.6;
    font-weight: 400;
  }

  .cta-wrapper {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 4rem;
    left: 6rem;
    animation: bounce 2s infinite;
    color: var(--mono-40);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
  }

  .decorative-blob {
    position: absolute;
    top: 20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
    z-index: 1;
  }

  @media (max-width: 1024px) {
    .monolith-hero { padding: 8rem 2rem 4rem; align-items: flex-start; }
    .meta-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    .hero-title { font-size: 4rem; margin-bottom: 2rem; }
    .scroll-indicator { display: none; }
    .hero-desc { font-size: 1.1rem; }
  }

  @media (max-width: 640px) {
    .meta-grid { grid-template-columns: 1fr; }
    .hero-title { font-size: 3rem; }
    .cta-wrapper { gap: 1rem; }
    .cta-wrapper a { width: 100%; justify-content: center; }
    .top-meta { flex-wrap: wrap; gap: 1rem; }
  }
</style>
